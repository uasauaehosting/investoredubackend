# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# FTP Upload (Hostinger - content images served from web hosting)
# When set, uploads go to FTP and public URLs are stored in the database.
FTP_HOST=ftp.ahwuae.com
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_SECURE=false
# The FTP account is chrooted to the uploads root, so use the relative folder
# "uploads" — NOT "/investorupload" (that would create a nested, unserved folder).
FTP_REMOTE_PATH=uploads
FTP_PUBLIC_BASE_URL=https://ahwuae.com/investorupload/uploads

# REQUIRED on Hostinger Node.js: set this to the absolute disk path of your uploads folder.
# This bypasses FTP for direct writes — faster and more reliable than FTP on the same server.
# SSH into Hostinger and run: pwd  (after navigating to public_html/investorupload/uploads)
# Example: UPLOAD_DIRECT_PATH=/home/u827794112/domains/ahwuae.com/public_html/investorupload/uploads
UPLOAD_DIRECT_PATH=/home/u827794112/domains/ahwuae.com/public_html/investorupload/uploads

# CORS Configuration
FRONTEND_URL=https://investoreducation.ahwuae.com
FRONTEND_URLS=https://investoreducation.ahwuae.com,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
